# Copy to .env and fill in the values marked REQUIRED.

# --- Gemini (Google AI Studio) ---------------------------------------------
# REQUIRED. Free key: https://aistudio.google.com/apikey
GOOGLE_API_KEY=
# Main reasoning model. Free tier is ~5 RPM / 20 RPD; switch to the Flash-Lite
# model below if you hit the daily quota on a free key.
GEMINI_MODEL=gemini-3.8-flash
# Used when the main model is unavailable or out of quota (~15 RPM / 500 RPD free).
GEMINI_FALLBACK_MODEL=gemini-3.5-flash-lite
# Lightweight model for the input guard, context extraction and summarization.
GEMINI_AUX_MODEL=gemini-3.5-flash-lite
GEMINI_EMBEDDING_MODEL=gemini-embedding-001
# Client-side rate limits, requests per minute: main model, and the fallback/aux
# model (quotas are per model, so the two never share a budget).
LLM_RPM=5
LLM_AUX_RPM=10
LLM_TIMEOUT_S=60
# No new retry of the same model starts after this many seconds; the fallback takes over.
# (An overloaded model can hold a request for almost LLM_TIMEOUT_S before answering 503.)
LLM_RETRY_BUDGET_S=30
# After the main model exhausts its retries on 5xx/timeouts, it is skipped for this many
# seconds and the fallback answers at once (0 = always try the main model first).
LLM_PRIMARY_COOLDOWN_S=300
# USD per 1M tokens, used only for the cost estimate in /stats.
LLM_PRICE_PER_1M_INPUT=0.75
LLM_PRICE_PER_1M_OUTPUT=3.75

# --- BigQuery --------------------------------------------------------------
# REQUIRED. Your GCP project used for billing/quota when querying the public dataset.
# Authenticate once with: gcloud auth application-default login
GOOGLE_CLOUD_PROJECT=
# Optional: path to a service-account key instead of gcloud ADC.
# GOOGLE_APPLICATION_CREDENTIALS=
BQ_DATASET=bigquery-public-data.thelook_ecommerce
BQ_MAX_BYTES_BILLED=2000000000
TURN_MAX_BQ_BYTES=10000000000
BQ_TIMEOUT_S=60

# --- Agent behaviour ---------------------------------------------------------
MAX_SQL_FAILURES=3
MAX_AGENT_STEPS=15
RESULT_ROWS_TO_LLM=50
SQL_DEFAULT_LIMIT=1000
INPUT_GUARD_LLM=true
HISTORY_KEEP_TURNS=6
HISTORY_SUMMARIZE_AFTER_TURNS=10

# --- Storage & logs ----------------------------------------------------------
APP_DB_PATH=data/app.db
CHECKPOINT_DB_PATH=data/checkpoints.db
EXPORTS_DIR=exports
LOG_PATH=logs/agent.jsonl
LOG_LLM_PAYLOADS=true

# --- LangSmith (optional) ----------------------------------------------------
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=retail-agent
